{% doc %}
  Ürün sayfası için schema.org BreadcrumbList: Ana sayfa › Koleksiyon › Ürün. Ziyaretçi ürüne bir
  koleksiyondan geldiyse koleksiyon basamağı eklenir, gelmediyse atlanır.

  Tema zaten breadcrumb işaretlemesi üretiyorsa (sayfa kaynağında "BreadcrumbList" arayın) eklemeyin.

  @param {product} product - Sayfadaki ürün

  @example
  {% render 'breadcrumb-yapisal-veri', product: product %}
{% enddoc %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ shop.name | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {%- if collection -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      },
      {%- endif -%}
      {
        "@type": "ListItem",
        "position": {% if collection %}3{% else %}2{% endif %},
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
    ]
  }
</script>
